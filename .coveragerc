[run]
# recidiviz/airflow runs in its own environment, and the Aikido Code Coverage workflow
# measures it there; counting it here would list all of it as untested.
omit = lib/*,recidiviz/tests/*,recidiviz/utils/data_migration.py,recidiviz/airflow/*
# Write paths relative to the repo root, so Aikido can match them to repository files.
relative_files = True
