{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recidiviz.org/sentence_calculator/law_regime_schema.json",
  "title": "Sentence Calculator Law Regime",
  "type": "object",
  "required": ["description", "effective_date"],
  "additionalProperties": false,
  "properties": {
    "description": { "type": "string" },
    "effective_date": { "type": "string", "format": "date" },
    "use_calendar_term_conversion": { "type": "boolean" },
    "days_per_month": { "type": "number", "exclusiveMinimum": 0 },
    "days_per_year": { "type": "number", "exclusiveMinimum": 0 },
    "conditions": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/sentence_condition" }
    },
    "term_multipliers": {
      "type": "array",
      "items": { "$ref": "#/$defs/term_multiplier" }
    },
    "credit_rates": {
      "type": "array",
      "items": { "$ref": "#/$defs/credit_rate" }
    },
    "credit_caps": {
      "type": "array",
      "items": { "$ref": "#/$defs/credit_cap" }
    },
    "projected_dates": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "$ref": "#/$defs/date_formula" },
          {
            "type": "array",
            "minItems": 1,
            "items": {
              "allOf": [
                { "$ref": "#/$defs/date_formula" },
                { "required": ["name"] }
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "term_multiplier": {
      "type": "object",
      "required": ["name", "description", "multiplier", "applies_to"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "when": { "$ref": "#/$defs/sentence_condition" },
        "multiplier": { "type": "number", "minimum": 0, "maximum": 1 },
        "applies_to": { "$ref": "#/$defs/applies_to" },
        "statute": { "type": "string" }
      }
    },
    "applies_to": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "min_term": { "$ref": "#/$defs/reduction_target" },
        "max_term": { "$ref": "#/$defs/reduction_target" }
      }
    },
    "reduction_target": {
      "oneOf": [
        { "const": "always" },
        {
          "type": "object",
          "required": ["when"],
          "additionalProperties": false,
          "properties": {
            "when": { "$ref": "#/$defs/sentence_condition" }
          }
        }
      ]
    },
    "credit_rate": {
      "type": "object",
      "required": ["name", "description", "rate", "per_unit", "unit", "applies_to"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "when": { "$ref": "#/$defs/sentence_condition" },
        "rate": { "type": "number", "minimum": 0 },
        "per_unit": { "type": "integer", "minimum": 1 },
        "unit": { "enum": ["DAY", "MONTH"] },
        "applies_to": { "$ref": "#/$defs/applies_to" },
        "statute": { "type": "string" }
      }
    },
    "credit_cap": {
      "type": "object",
      "required": ["name", "description", "max_credit_days", "binds"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "when": { "$ref": "#/$defs/sentence_condition" },
        "max_credit_days": { "type": "string" },
        "binds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["min_term", "max_term"] }
        },
        "statute": { "type": "string" }
      }
    },
    "date_formula": {
      "type": "object",
      "required": ["description", "formula"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "when": { "$ref": "#/$defs/projected_date_condition" },
        "formula": { "type": "string" },
        "floor": {
          "type": "object",
          "required": ["date"],
          "additionalProperties": false,
          "properties": {
            "date": { "type": "string" },
            "when": { "$ref": "#/$defs/projected_date_condition" }
          }
        },
        "statute": { "type": "string" }
      }
    },
    "sentence_condition": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "all_of": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sentence_condition" }
        },
        "any_of": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sentence_condition" }
        },
        "condition": { "type": "string" }
      },
      "additionalProperties": { "$ref": "#/$defs/field_matcher" }
    },
    "value_condition": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "all_of": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/value_condition" }
        },
        "any_of": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/value_condition" }
        }
      },
      "additionalProperties": { "$ref": "#/$defs/field_matcher" }
    },
    "projected_date_condition": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "all_of": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/value_condition" }
        },
        "any_of": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/value_condition" }
        },
        "sentence_condition_key": { "$ref": "#/$defs/sentence_condition" }
      },
      "additionalProperties": { "$ref": "#/$defs/field_matcher" }
    },
    "field_matcher": {
      "oneOf": [
        { "type": ["string", "number", "boolean"] },
        { "type": "array" },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": false,
          "properties": {
            "equals": {},
            "not_equals": {},
            "greater_than": { "type": "number" },
            "greater_than_or_equal": { "type": "number" },
            "less_than": { "type": "number" },
            "less_than_or_equal": { "type": "number" },
            "in": { "type": "array" },
            "not_in": { "type": "array" },
            "before": { "type": "string", "format": "date" },
            "on_or_before": { "type": "string", "format": "date" },
            "after": { "type": "string", "format": "date" },
            "on_or_after": { "type": "string", "format": "date" },
            "between_inclusive": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "string", "format": "date" }
            }
          }
        }
      ]
    }
  }
}
