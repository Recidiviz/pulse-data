# This Dockerfile is for the image associated with deploying a single pipeline with flex dataflow templates.

FROM gcr.io/dataflow-templates-base/python311-template-launcher-base

# Patch system-level packages (e.g. openssl, libssh) to address any security
# vulnerabilities in the base image with recently released patches.
# NOTE: This makes builds less reproducible since the patches depend on what's available
# at build time, but ensures we pick up security fixes without waiting for Google to
# update the base image.
RUN apt-get update -y && apt-get upgrade -y

ARG WORKDIR=/dataflow/template
ARG GOOGLE_CLOUD_PROJECT
ARG RECIDIVIZ_ENV
ENV GOOGLE_CLOUD_PROJECT=${GOOGLE_CLOUD_PROJECT}
ENV RECIDIVIZ_ENV=${RECIDIVIZ_ENV}
RUN mkdir -p ${WORKDIR}
WORKDIR ${WORKDIR}

# Copy source files
COPY ./recidiviz/pipelines/dataflow_flex_setup.py ${WORKDIR}/setup.py
COPY ./recidiviz/pipelines/flex_pipeline_runner.py ${WORKDIR}/pipeline_runner.py
# setup.py reads its install_requires out of this file, so it must land alongside
# setup.py before the install below. The MANIFEST.in is what keeps it in the sdist
# Beam later builds here and stages to Dataflow workers.
COPY ./recidiviz/pipelines/dataflow_flex_requirements.txt ${WORKDIR}/dataflow_flex_requirements.txt
COPY ./recidiviz/pipelines/dataflow_flex_MANIFEST.in ${WORKDIR}/MANIFEST.in

# Install apache-beam and other dependencies to launch the pipeline
# --no-cache-dir means the pip cache won't be used. Using the pip cache makes the image unnecessarily larger,
# when the docker cache can be used instead. this flag is needed to prevent worker memory/start up issues
# we increase the timeout from the default (15s) to avoid 'Connection reset by peer' errors that may be due to a timeout
RUN pip install --no-cache-dir --timeout=150 apache-beam[gcp]==2.65.0
RUN pip install --no-cache-dir ${WORKDIR}/.

COPY . ${WORKDIR}

# setuptools treats a co-located pyproject.toml's [project] table as authoritative
# over setup.py's own setuptools.setup() arguments (name, version, install_requires),
# so once the full repo lands in ${WORKDIR} above, the root pyproject.toml would
# silently override every pin curated in dataflow_flex_setup.py when Beam later runs
# `python setup.py sdist` here to build the artifact staged to Dataflow workers.
# Removing it restores setup.py as the authoritative source for this image.
RUN rm ${WORKDIR}/pyproject.toml

ENV FLEX_TEMPLATE_PYTHON_SETUP_FILE="${WORKDIR}/setup.py"
ENV FLEX_TEMPLATE_PYTHON_PY_FILE="${WORKDIR}/pipeline_runner.py"

# PIP_NO_DEPS needs to be set to True to prevent the dependencies from being installed again,
# this is needed to prevent worker memory/start up issues
ENV PIP_NO_DEPS=True
