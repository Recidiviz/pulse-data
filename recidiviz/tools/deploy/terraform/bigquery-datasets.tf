# Creates the BigQuery datasets registered in
# config/terraform_managed_bigquery_datasets.yaml. The registry YAML is
# autogenerated from
# recidiviz/tools/deploy/generate_terraform_managed_bigquery_datasets.py (see
# that file for the registry format); a unit test fails if it is stale.
#
# Most registered datasets hold tables managed by the source-table framework
# (recidiviz/source_tables/). Terraform creates the dataset shell; the
# framework manages the tables inside. The framework's own dataset creation
# (BigQueryClientImpl.create_dataset_if_necessary) is a get-or-create, so it
# no-ops on the datasets created here and still covers sandbox datasets, which
# are intentionally not registered.
#
# When a dataset leaves the registry (a collection is deleted), the next apply
# plans a destroy, which fails on a non-empty dataset because the module keeps
# delete_contents_on_destroy = false. That fail-closed behavior is intentional;
# deleting real data should require a human to empty the dataset first.

locals {
  # An absent projects key means the dataset exists in every data-platform
  # project this config deploys to, so the current project always qualifies.
  terraform_managed_bigquery_datasets = {
    for dataset_id, config in yamldecode(file("${path.module}/config/terraform_managed_bigquery_datasets.yaml"))["datasets"] :
    dataset_id => config
    if contains(try(config.projects, [var.project_id]), var.project_id)
  }
}

module "terraform_managed_bigquery_dataset" {
  for_each                    = local.terraform_managed_bigquery_datasets
  source                      = "./modules/big_query_dataset"
  dataset_id                  = each.key
  description                 = each.value.description
  default_table_expiration_ms = try(each.value.default_table_expiration_ms, null)
}

# These datasets were previously declared as standalone modules (in bigquery.tf,
# bigquery-scheduled-queries.tf, and cloud-logging.tf) and are now driven by the
# registry.
moved {
  from = module.supplemental_generated_dataset
  to   = module.terraform_managed_bigquery_dataset["supplemental_data"]
}

moved {
  from = module.export_archives_dataset
  to   = module.terraform_managed_bigquery_dataset["export_archives"]
}

moved {
  from = module.eomis_writeback_metadata_dataset
  to   = module.terraform_managed_bigquery_dataset["eomis_writeback_metadata"]
}

moved {
  from = module.validation_results_dataset
  to   = module.terraform_managed_bigquery_dataset["validation_results"]
}

moved {
  from = module.twilio_webhook_requests_dataset
  to   = module.terraform_managed_bigquery_dataset["twilio_webhook_requests"]
}

moved {
  from = module.raw_data_comparison_output
  to   = module.terraform_managed_bigquery_dataset["raw_data_comparison_output"]
}

moved {
  from = module.experiments_metadata
  to   = module.terraform_managed_bigquery_dataset["experiments_metadata"]
}

moved {
  from = module.static_reference_tables
  to   = module.terraform_managed_bigquery_dataset["static_reference_tables"]
}

moved {
  from = module.google_sheet_backed_tables
  to   = module.terraform_managed_bigquery_dataset["google_sheet_backed_tables"]
}

moved {
  from = module.manually_updated_source_tables
  to   = module.terraform_managed_bigquery_dataset["manually_updated_source_tables"]
